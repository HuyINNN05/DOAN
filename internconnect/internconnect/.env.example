NODE_ENV=development
PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=internconnect
DB_PASSWORD=change_me
# Both databases must be on the same MySQL server.
DB_SCHOOL_NAME=internconnect_school
DB_COMPANY_NAME=internconnect_company
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_a_different_32_character_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880
# Account provisioning email: fill these before sending activation links.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_PUBLIC_URL=http://localhost:5173
ACCOUNT_ACTIVATION_HOURS=24
# Optional comma-separated school email domains (empty = validate email format only).
SCHOOL_EMAIL_DOMAINS=
