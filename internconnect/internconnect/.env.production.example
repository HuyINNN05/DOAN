# Copy to .env.production and chmod 600. Preserve existing DB credentials/JWT secrets.
NODE_ENV=production
PORT=3001
TRUST_PROXY_HOPS=1
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=internconnect
DB_PASSWORD=
DB_SCHOOL_NAME=internconnect_school
DB_COMPANY_NAME=internconnect_company
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=
APP_PUBLIC_URL=
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_BYTES=5242880
NGINX_PORT=8080
# Existing absolute directory; required for base-file interpolation even with volume override.
UPLOADS_HOST_PATH=
# Docker DB mode: existing network, DB_HOST=verified container DNS alias.
EXISTING_DB_NETWORK=
# Optional named upload volume override.
EXISTING_UPLOADS_VOLUME=
APP_IMAGE_TAG=local
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ACCOUNT_ACTIVATION_HOURS=24
SCHOOL_EMAIL_DOMAINS=
